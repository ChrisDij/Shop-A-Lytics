# ---- Flask basics -------------------------------------------------
# Tells Flask which file starts the backend.
FLASK_APP=backend/run.py
# 1 = development mode (auto-reload, detailed error pages). Set to 0 for a demo or production.
FLASK_DEBUG=1
# Secret used to sign login sessions. Replace with a long random string in your own .env.
# Never commit the real value.
SECRET_KEY=replace-with-a-random-local-secret

# ---- Databases ----------------------------------------------------
# The APPLICATION database: users, feedback, reports and the audit log.
# Kept separate from BoschCard data so a data reload never deletes accounts.
DATABASE_URL=sqlite:///data/app.sqlite

# The ANALYTICS database: privacy-safe BoschCard data, built by data_tools/load_analytics.py.
# The app only reads it, and it is rebuilt whenever new data arrives.
ANALYTICS_DB_PATH=data/analytics.sqlite

# Local demo fallback while the authentication slice is being integrated.
# Remove this value in shared/deployed environments; authenticated sessions set their own vendor.
DEMO_VENDOR_ID=1

# ---- Privacy and analytics settings -------------------------------
# Secret used to turn student numbers into anonymous pseudonyms.
# Keep it private and use the same value on every data load, or pseudonyms change.
BOSCHCARD_SALT=replace-with-a-long-random-string
# Minimum number of students or transactions behind any figure shown.
# Smaller groups are hidden so individuals can't be identified (NFR 3).
MIN_GROUP_SIZE=10
# Minimum days of history before anomaly detection runs.
# Below this, the app shows "Not assessed: insufficient history" (NFR 10).
MIN_HISTORY_DAYS=90

# Optional calendar overrides. The defaults below are used when these are omitted.
PUBLIC_HOLIDAYS_PATH=data/reference/public_holidays/public_holidays.csv
UNIVERSITY_CALENDAR_PATH=data/reference/university_calendar/university_calendar.csv
